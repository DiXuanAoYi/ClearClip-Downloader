{
  "name": "clearclip",
  "private": true,
  "version": "1.15.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "i18n": "node scripts/i18n.mjs",
    "lint:colors": "node scripts/lint-colors.mjs",
    "release:version": "node scripts/version.mjs",
    "release:check": "node scripts/version.mjs --check",
    "tauri": "tauri",
    "gen:types": "node scripts/gen-types.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings --test \"e2e/unit/*.test.mjs\"",
    "test:e2e": "node e2e/run.mjs",
    "test:ext": "node e2e/ext/writing-smoke.mjs",
    "test:component": "vitest run",
    "test:component:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:commands": "node scripts/check-commands.mjs",
    "test": "npm run test:unit && npm run test:component && npm run check:commands && npm run test:e2e"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "element-plus": "^2.14.8",
    "pinia": "^3.0.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^26.1.0",
    "playwright": "1.65.0",
    "typescript": "~5.9.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.7",
    "vue-tsc": "3.3.13"
  }
}

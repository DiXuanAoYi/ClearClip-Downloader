{
  "name": "clearclip",
  "private": true,
  "version": "0.10.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "i18n": "node scripts/i18n.mjs",
    "tauri": "tauri",
    "test:unit": "node --experimental-strip-types --no-warnings --test \"e2e/unit/*.test.mjs\"",
    "test:e2e": "node e2e/run.mjs",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "element-plus": "^2.14.7",
    "pinia": "^3.0.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "playwright": "1.56.1",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.3.12"
  }
}

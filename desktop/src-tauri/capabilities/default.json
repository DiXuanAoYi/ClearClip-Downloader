{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口、迷你窗和悬浮拖拽窗可用的权限。平台登录窗口不在此列，无法调用任何命令。",
  "windows": [
    "main",
    "mini",
    "float"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}

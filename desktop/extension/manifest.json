{
  "manifest_version": 3,
  "name": "发送到清影 ClearClip",
  "version": "1.2.0",
  "description": "把当前网页、链接或视频一键发送到电脑上的清影下载，自动发现网页里的视频流，并可同步当前网站的登录 Cookie。",
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "发送到清影"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "shared.js",
      "background.js"
    ]
  },
  "permissions": [
    "contextMenus",
    "cookies",
    "storage",
    "activeTab",
    "notifications",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "popup.html#settings",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "clearclip@dixuanaoyi.github.io",
      "strict_min_version": "121.0"
    }
  }
}
